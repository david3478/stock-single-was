# EC2의 deploy 폴더에 .env로 복사해 값을 채운다. 실제 비밀번호는 git에 올리지 않는다.
APP_IMAGE=<계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com/stock-single-was:<git-sha>
FRONT_IMAGE=<계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com/stock-single-was-front:<git-sha>
HTTP_PORT=80
# RDS 엔드포인트. 로컬 검증(compose.local-db.yml)에서는 mysql
DB_HOST=<RDS 엔드포인트>
DB_USER=ssw
DB_PASSWORD=<강한 비밀번호>
# 로컬 검증에서만 쓴다
# MYSQL_ROOT_PASSWORD=<비밀번호>
